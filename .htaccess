# Cabeceras que una etiqueta meta no puede aplicar (anti-clickjacking e HTTPS).
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data:; font-src https://fonts.gstatic.com; media-src 'self'; connect-src 'self'; frame-ancestors 'none'"
  Header set Strict-Transport-Security "max-age=31536000"
</IfModule>
