# Cabeceras que una etiqueta meta no puede aplicar (anti-clickjacking e HTTPS).
# docs/, tools/ y private/ se niegan con su propio .htaccess (Require all denied).
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data:; font-src https://fonts.gstatic.com; media-src 'self'; connect-src 'self'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Enlaces antiguos de mfg-collection.html (ya no existe) que siguen en correos y buscadores:
# ?coleccion=me va a M&E; cualquier otro, a PD&M. El "?" final quita el parámetro viejo.
# HTTPS solo en el dominio público, para no romper una vista local sin certificado.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # private/, docs/ y tools/ tampoco se sirven si el .htaccess de la carpeta no se lee.
  RewriteRule ^(private|docs|tools)(/|$) - [F,L]

  # Un visitante con IP pública no puede saltarse el HTTPS inventando X-Forwarded-Proto.
  # Esa cabecera solo se consulta en la regla siguiente, cuando quien conecta es un proxy de red privada.
  RewriteCond %{HTTP_HOST} ^(www\.)?cadgrafics\.com\.mx$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REMOTE_ADDR} !^10\.
  RewriteCond %{REMOTE_ADDR} !^192\.168\.
  RewriteCond %{REMOTE_ADDR} !^172\.(1[6-9]|2[0-9]|3[01])\.
  RewriteCond %{REMOTE_ADDR} !^127\.
  RewriteCond %{REMOTE_ADDR} !^::1$
  RewriteCond %{REMOTE_ADDR} !^f[cd][0-9a-f]{2}: [NC]
  RewriteCond %{REMOTE_ADDR} !^fe80: [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Proxy interno que ya recibió la visita por HTTPS: no redirigir en bucle.
  # Si el balanceador tiene IP pública, hay que tratarla como privada en las condiciones de arriba.
  RewriteCond %{HTTP_HOST} ^(www\.)?cadgrafics\.com\.mx$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)coleccion=me(&|$) [NC]
  RewriteRule ^pages/autodesk/mfg-collection\.html$ /pages/autodesk/me-collection.html? [R=301,L]
  RewriteRule ^pages/autodesk/mfg-collection\.html$ /pages/autodesk/pdm-collection.html? [R=301,L]
</IfModule>
<IfModule !mod_rewrite.c>
  Redirect 301 /pages/autodesk/mfg-collection.html /pages/autodesk/pdm-collection.html
</IfModule>
